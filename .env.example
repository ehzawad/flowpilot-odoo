# Copy to .env for local development. Never commit real values.

# Application/runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=FlowPilot
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://flowpilot:flowpilot@product-db:5432/flowpilot
WORKER_DATABASE_URL=postgresql+psycopg://flowpilot:flowpilot@product-db:5432/flowpilot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=15
AUTO_CREATE_SCHEMA=false
SEED_DEMO_DATA=true

# Agent runtime. fake is complete and deterministic; openai requires a server-side key.
AGENT_RUNTIME=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_FRONTIER_MODEL=gpt-5.6-sol
OPENAI_COMPACTION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
USE_FRONTIER_FOR_CRITICAL=false
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_INPUT_TOKENS=90000
AGENT_MAX_OUTPUT_TOKENS=5000
AGENT_COMPACTION_TRIGGER_ITEMS=24
AGENT_SOFT_COST_LIMIT_USD=1.00
OPENAI_TRACING_ENABLED=false

# Update these when provider prices change. They are used for an application cost ledger.
OPENAI_LUNA_INPUT_USD_PER_MILLION=1.00
OPENAI_LUNA_OUTPUT_USD_PER_MILLION=6.00
OPENAI_TERRA_INPUT_USD_PER_MILLION=2.50
OPENAI_TERRA_OUTPUT_USD_PER_MILLION=15.00
OPENAI_SOL_INPUT_USD_PER_MILLION=5.00
OPENAI_SOL_OUTPUT_USD_PER_MILLION=30.00

# Odoo 19 JSON-2. Use ODOO_CONNECTIONS_JSON from a secret manager for multi-tenant deployments.
ODOO_MODE=fake
ODOO_WRITE_MODE=bridge
ODOO_BASE_URL=http://odoo:8069
ODOO_DATABASE=flowpilot_demo
ODOO_API_KEY=
ODOO_CONNECTIONS_JSON=
ODOO_TIMEOUT_SECONDS=20
ODOO_RETRY_ATTEMPTS=3
ODOO_MCP_URL=http://odoo-mcp:8010/mcp
ODOO_MCP_PUBLIC_URL=http://localhost:8010/mcp
ODOO_MCP_HOST=0.0.0.0
ODOO_MCP_PORT=8010
ODOO_MCP_SERVICE_TOKEN=development-only-token
ODOO_BRIDGE_WEBHOOK_SECRET=development-webhook-secret
ODOO_ACTION_SIGNING_SECRET=development-action-secret
WEBHOOK_MAX_AGE_SECONDS=300
AUTO_INVESTIGATE_ODOO_EVENTS=true

# Local authenticated supplier-portal MCP simulator. Never deploy it as a real supplier system.
SUPPLIER_MCP_ENABLED=true
SUPPLIER_MCP_HOST=0.0.0.0
SUPPLIER_MCP_PORT=8020
SUPPLIER_MCP_PUBLIC_URL=http://localhost:8020/mcp
SUPPLIER_MCP_SERVICE_TOKEN=development-supplier-token

# Third-party MCP client path. Replace URL/token/allowlist for a real external server.
THIRD_PARTY_MCP_ENABLED=true
THIRD_PARTY_MCP_NAME=supplier-portal
THIRD_PARTY_MCP_URL=http://supplier-mcp:8020/mcp
THIRD_PARTY_MCP_BEARER_TOKEN=development-supplier-token
THIRD_PARTY_MCP_ALLOWED_TOOLS=get_supplier_order_status,get_carrier_eta

# Optional OpenAI-hosted connector. Read-like tools only; writes are denied.
GOOGLE_CALENDAR_MCP_ENABLED=false
GOOGLE_CALENDAR_AUTHORIZATION=

# Auth. Demo headers are automatically forbidden in production.
AUTH_MODE=demo
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
DEMO_TENANT_ID=tenant-demo
DEMO_USER_ID=user-demo

# Storage / event delivery
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_BUCKET=flowpilot
OBJECT_STORAGE_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EVENT_SINK_URL=
EVENT_SINK_BEARER_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=flowpilot-api
PROMETHEUS_ENABLED=true

# Worker
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=6
WORKER_CONCURRENCY=1

# Frontend BFF. The browser calls the same-origin Next.js proxy; secrets stay server-side.
INTERNAL_API_BASE_URL=http://api:8000
FLOWPILOT_WEB_AUTH_MODE=demo
DEMO_USER_EMAIL=operator@northstar.example
